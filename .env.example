# ==============================================================================
# E-SPb PPDB Portal — Environment Configuration
# ==============================================================================

# Public URL of the Application (e.g. http://localhost:3000 or https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Cloud Service Account Authentication (For Google Sheets & Drive APIs)
# ------------------------------------------------------------------------------
# Email address of the Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com

# Private key of the Service Account (enclose in quotes, preserve \n newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Master Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Root Google Drive Folder ID for uploaded files, documents, and assets
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here

# ------------------------------------------------------------------------------
# Google OAuth 2.0 & OpenID Connect (For Verified Workspace Login with @moe.gov.my)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Admin Authentication & Security
# ------------------------------------------------------------------------------
# Fallback administrator emails (comma-separated, verified by Google OAuth)
ADMIN_EMAILS="admin@moe.gov.my"

# Cryptographic secret for signing session tokens (min 32 characters)
SESSION_SECRET=espb_ppdb_super_secure_jwt_session_secret_key_beluran_2026_sabah

# Session duration in hours (defaults to 4 hours)
SESSION_DURATION_HOURS=4

# ------------------------------------------------------------------------------
# Portal Defaults & Overrides
# ------------------------------------------------------------------------------
PORTAL_NAME="E-SPb PPDB"
SECTOR_NAME="Sektor Pembelajaran"
DISTRICT="Pejabat Pendidikan Daerah Beluran"
STATE="Sabah"
CONTACT_EMAIL="ppd.beluran@moe.gov.my"
CONTACT_PHONE="089-511 503"
ADDRESS="Pejabat Pendidikan Daerah Beluran, Peti Surat 27, 90107 Beluran, Sabah, Malaysia"
CARTA_ORGANISASI_URL="https://drive.google.com/file/d/1plKZgpVPVOWggd_LS1O9TabTHYkqeU_T/view?usp=sharing"
E_KEBERADAAN_URL="https://script.google.com/macros/s/AKfycbwDy8XuqQHxgfoptFV_oLNlSiawkdwXk_LC46BKWnsreUW0P7piXMC4cfDC6ENYZl3F/exec"
